VERSION = "1.0.0"   # CHANGELOG.md
DRY_RUN = False


def version_string() -> str:
    """The version and the checkout it runs from (commit, -dirty with local changes); recordings note it."""
    sha = subprocess.run(["git", "-C", str(REPO), "describe", "--always", "--dirty"], capture_output=True,
                         text=True).stdout.strip()
    return f"{VERSION} ({sha})" if sha else VERSION


class _VersionAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None) -> None:
        print(f"jxb {version_string()}")
        parser.exit()


def info(msg: str) -> None:
    print(f"\033[36m[jxb]\033[0m {msg}", flush=True)


def fail(msg: str, code: int = 1) -> None:
    print(f"\033[31m[jxb] {msg}\033[0m", file=sys.stderr, flush=True)
    sys.exit(code)


def sh(cmd: list[str], check: bool = True, **kw) -> subprocess.CompletedProcess:
    if DRY_RUN:
        print("+ " + shlex.join(cmd))
        return subprocess.CompletedProcess(cmd, 0, "", "")
    res = subprocess.run(cmd, **kw)
    if check and res.returncode != 0:
        fail(f"command failed ({res.returncode}): {shlex.join(cmd[:6])}{' ...' if len(cmd) > 6 else ''}",
             res.returncode)
    return res


def load_toml(path: Path) -> dict:
    return tomllib.loads(path.read_text()) if path.exists() else {}


# ------------------------------------------------------------------------------------------ profile
class Profile:
    def __init__(self, name: str | None):
        local = load_toml(REPO / "jxb.toml")
        names = sorted(p.stem for p in (REPO / "profiles").glob("*.toml"))
        name = name or os.environ.get("JXB_PROFILE") or local.get("profile") or (names[0] if len(names) == 1 else None)
        if not name:
            fail(f"choose a profile with --profile ({', '.join(names)})")
        path = REPO / "profiles" / f"{name}.toml"
        if not path.exists():
            fail(f"unknown profile {name} ({', '.join(names)})")
        self.name, self.path, self.data, self.local = name, path, load_profile(path), local
        self.image = self.data["image"]["tag"]
        self.sysroot = (REPO / self.data["sysroot"]["dir"]).resolve()
        self.container = f"jxb-{name}"
        self.cuda = self.data["image"]["cuda_version"]
        self.cuda_target = self.data["sysroot"].get("cuda_target", "sbsa-linux")
        self.distro = self.data["board"]["ros_distro"]
        self.mode = local.get("mode", "auto")   # where board commands run (--mode), see uses_container()

    def workspace(self, ws: Path) -> dict:
        """jxb.toml [workspace.<dir name>]: `files` of the source tree to deploy (launch files that include others
        from src/, configs, models), `env` for the board (any mode) and `container_env` (container mode)."""
        return self.local.get("workspace", {}).get(ws.name, {})


def docker_state(name: str) -> str:
    res = subprocess.run(["docker", "inspect", "-f", "{{.State.Status}}", name], capture_output=True, text=True)
    return res.stdout.strip() if res.returncode == 0 else ""


def container_mounts(name: str) -> list[Path]:
    res = subprocess.run(["docker", "inspect", "-f", "{{range .Mounts}}{{.Destination}}\n{{end}}", name],
                         capture_output=True, text=True)
    return [Path(l) for l in res.stdout.splitlines() if l.strip()]


# ------------------------------------------------------------------------------------- image/sysroot
def cmd_image(p: Profile, a) -> None:
    if a.action == "runtime":   # the board's runtime image (--mode container), built here, loaded on first use
        info(f"runtime image ready: {build_runtime_image(p)}")
        return
    i = p.data["image"]
    sh(["docker", "build", "-f", str(REPO / i["dockerfile"]), "-t", p.image,
        "--build-arg", f"UBUNTU={i.get('ubuntu', '24.04')}",
        "--build-arg", f"ROS_APT_URL={i.get('ros_apt_url', 'http://packages.ros.org/ros2/ubuntu')}",
        "--build-arg", f"ROS_APT_KEY_URL={i.get('ros_apt_key_url', 'https://raw.githubusercontent.com/ros/rosdistro/master/ros.key')}",
        "--build-arg", f"ROS_TOOLS_APT_URL={i.get('ros_tools_apt_url', '')}",
        "--build-arg", f"ROS_DISTRO={i['ros_distro']}", "--build-arg", f"CUDA_DASH={i['cuda_dash']}",
        "--build-arg", f"CUDA_PKG_VERSION={i['cuda_pkg_version']}", "--build-arg", f"CUDA_TARGET={p.cuda_target}",
        "--build-arg", f"USER_UID={os.getuid()}", "--build-arg", f"USER_GID={os.getgid()}", str(REPO)])


def cmd_sysroot(p: Profile, a) -> None:
    if a.action == "info":
        meta = p.sysroot / ".jxb"
        if not meta.exists():
            fail(f"no sysroot at {p.sysroot}; run: jxb sysroot build")
        print((meta / "info.json").read_text())
        return
    if a.action == "rosdeps":
        if not a.workspace:
            fail("usage: jxb sysroot rosdeps -w WORKSPACE")
        ws = Path(a.workspace).resolve()
        set_name = f"ws-{p.name}-{ws.name}"
        sets = REPO / "sysroot/sets"
        sh(["docker", "run", "--rm", "--network", "host", "-v", f"{REPO}:/opt/jxb:ro", "-v", f"{sets}:{sets}",
            "-v", f"{ws}:{ws}:ro", "-e", f"ROS_DISTRO={p.distro}",
            "-e", f"JXB_UBUNTU_CODENAME={p.data['sysroot'].get('codename', 'noble')}",
            "-e", f"JXB_ROSDEP_FALLBACK_CODENAME={p.data['sysroot'].get('rosdep_fallback_codename', '')}", p.image,
            "python3", "/opt/jxb/toolchain/bin/jxb-rosdeps", str(ws), str(sets / f"{set_name}.txt")])
        info(f"add \"{set_name}\" to [sysroot] extra_sets in jxb.toml, then: jxb sysroot build")
        return
    cache = REPO / "sysroots/.cache" / p.name
    cmd = ["docker", "run", "--rm", "--network", "host",
           "-v", f"{REPO}:/opt/jxb:ro", "-v", f"{p.sysroot.parent}:{p.sysroot.parent}",
           "-e", "JXB_HOME=/opt/jxb", p.image,
           "python3", "/opt/jxb/sysroot/build_sysroot.py", "--profile", f"/opt/jxb/profiles/{p.name}.toml",
           "--out", str(p.sysroot), "--cache", str(cache), "--deb-cache", str(REPO / "sysroots/.cache/debs")]
    extra_sets = []
    for name in p.local.get("sysroot", {}).get("extra_sets", []):
        name = name.replace("{profile}", p.name)
        if (REPO / "sysroot/sets" / f"{name}.txt").exists():
            extra_sets.append(name)
        else:
            info(f"skipping extra set {name} (not found; create it with: jxb sysroot rosdeps -w <workspace>)")
    if extra_sets:
        cmd += ["--extra-sets", *extra_sets]
    if a.add:
        cmd += ["--add", *a.add]
    if a.no_update:
        cmd += ["--no-update"]
    p.sysroot.parent.mkdir(parents=True, exist_ok=True)
    sh(cmd)
    # The build swaps the sysroot directory; a running container still sees the old one.
    if docker_state(p.container):
        label = subprocess.run(["docker", "inspect", "-f", '{{index .Config.Labels "jxb.workspaces"}}', p.container],
                               capture_output=True, text=True).stdout.strip()
        info(f"recreating {p.container} for the new sysroot")
        cmd_up(p, argparse.Namespace(workspace=[w for w in label.split(":") if w], recreate=True))


# ----------------------------------------------------------------------------------------- container
def cmd_up(p: Profile, a) -> None:
    if not (p.sysroot / ".jxb/profile.json").exists():
        fail(f"sysroot missing: {p.sysroot} (run: jxb sysroot build)")
    workspaces = [Path(w).resolve() for w in (a.workspace or p.local.get("workspaces", []))]
    state = docker_state(p.container)
    if state and not a.recreate:
        missing = [w for w in workspaces if w not in container_mounts(p.container)]
        if missing:
            fail(f"container exists without {', '.join(map(str, missing))}; use: jxb up --recreate -w ...")
        if state != "running":
            sh(["docker", "start", p.container], stdout=subprocess.DEVNULL)
        info(f"container {p.container} running")
        return
    if state:
        sh(["docker", "rm", "-f", p.container], stdout=subprocess.DEVNULL)
    target = p.sysroot / f"usr/local/cuda-{p.cuda}/targets/{p.cuda_target}"
    host_cuda = f"/usr/local/cuda-{p.cuda}/targets"
    cmd = ["docker", "run", "-d", "--name", p.container, "--hostname", p.container, "--init",
           "--network", "host",
           "-v", f"{REPO}:/opt/jxb:ro", "-v", f"{REPO}:{REPO}",
           "-v", f"{p.sysroot}:{p.sysroot}:ro",
           "-v", f"{target}:{host_cuda}/{p.cuda_target}:ro", "-v", f"{target}:{host_cuda}/aarch64-linux:ro",
           "-v", f"jxb-ccache-{p.name}:/home/dev/.ccache",
           "-e", f"ARM64_SYSROOT={p.sysroot}", "-e", "JXB_HOME=/opt/jxb",
           "--label", f"jxb.profile={p.name}", "--label", f"jxb.workspaces={':'.join(map(str, workspaces))}"]
    for bp in p.data.get("container", {}).get("board_paths", []):
        if (p.sysroot / bp.lstrip("/")).exists():
            cmd += ["-v", f"{p.sysroot / bp.lstrip('/')}:{bp}:ro"]
    for w in workspaces:
        if not w.is_dir():
            fail(f"workspace not found: {w}")
        cmd += ["-v", f"{w}:{w}"]
    sh(cmd + [p.image], stdout=subprocess.DEVNULL)
    sh(["docker", "exec", "-u", "root", p.container, "chown", "dev:dev", "/home/dev/.ccache"])
    info(f"container {p.container} up; workspaces: {', '.join(map(str, workspaces)) or '(none)'}")


def ensure_up(p: Profile) -> None:
    if docker_state(p.container) != "running":
        cmd_up(p, argparse.Namespace(workspace=None, recreate=False))


def container_cwd(p: Profile) -> str:
    cwd = Path.cwd().resolve()
    for m in container_mounts(p.container):
        if m != Path("/opt/jxb") and (cwd == m or m in cwd.parents):
            return str(cwd)
    return "/home/dev"


def in_container(p: Profile, command: str, interactive: bool = False, cwd: str | None = None) -> int:
    ensure_up(p)
    flags = ["-it"] if interactive and sys.stdin.isatty() else (["-t"] if sys.stdout.isatty() else [])
    cmd = ["docker", "exec", *flags, "-w", cwd or container_cwd(p), p.container, "bash", "-lc", command]
    return sh(cmd, check=False).returncode


def cmd_down(p: Profile, a) -> None:
    if docker_state(p.container):
        sh(["docker", "rm", "-f", p.container], stdout=subprocess.DEVNULL)
    info(f"container {p.container} removed (ccache volume kept)")


def cmd_shell(p: Profile, a) -> None:
    sys.exit(in_container(p, "exec bash -l", interactive=True))


def cmd_exec(p: Profile, a) -> None:
    if not a.cmd:
        fail("usage: jxb exec -- CMD ...")
    sys.exit(in_container(p, shlex.join(a.cmd), interactive=True))


def cmd_build(p: Profile, a) -> None:
    if container_cwd(p) == "/home/dev":
        fail(f"{Path.cwd()} is not mounted in {p.container}; run: jxb up --recreate -w <workspace>")
    sys.exit(in_container(p, shlex.join(["cross-colcon-build", *a.args])))


def cmd_test(p: Profile, a) -> None:
    out = REPO / ".work/tests" / p.name
    rc = in_container(p, shlex.join(["/opt/jxb/tests/run.sh", str(out)]), cwd=str(REPO))
    if rc != 0:
        sys.exit(rc)
    if a.board:
        board = Board(a.board, p)
        prepare_board(p, board)
        dest = f"{board.base}/tests"
        info(f"copying tests to {board.name}:{dest}")
        board.ssh(f"mkdir -p {shlex.quote(dest)}")
        board.rsync(f"{out}/stage/", dest)
        env = board_ros_setup(p, board) + board_runtime_libs(p, board)
        ensure_board_libs(p, board, env + f"export LD_LIBRARY_PATH={dest}/lib:$LD_LIBRARY_PATH && ", [dest])
        skip = ""
        if uses_container(p, board):   # these steps initialize ONNX Runtime's CUDA EP (--ep tensorrt falls back to it)
            skip = "ort_cuda ort_tensorrt ort_bench"
            info(f"container mode: skipping {skip}: the board reset once while ONNX Runtime's CUDA EP initialized "
                 "in a runtime container (docs/findings.md F56)")
        script = env + f"ROS_DISTRO={p.distro} JXB_TEST_SKIP={shlex.quote(skip)} bash {shlex.quote(dest)}/run_on_board.sh"
        sys.exit(board.ssh(board_exec(p, board, script, login=False), tty=False, check=False))


# --------------------------------------------------------------------------------------------- boards
class Board:
    def __init__(self, name: str, p: Profile):
        inv = load_toml(REPO / "boards.toml")
        if not inv:
            fail("no boards.toml (copy boards.example.toml)")
        if name not in inv.get("boards", {}):
            fail(f"unknown board {name}; known: {', '.join(inv.get('boards', {}))}")
        cfg = {**inv.get("defaults", {}), **inv["boards"][name]}
        self.name, self.cfg, self.p = name, cfg, p
        self.host, self.user = cfg["host"], cfg.get("user", "nvidia")
        self.base = cfg.get("deploy_dir", f"/home/{self.user}/jxb/{p.name}")
        self.target = f"{self.user}@{self.host}"
        self.ssh_opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=accept-new",
                         "-p", str(cfg.get("ssh_port", 22))]

    def ssh(self, command: str, tty: bool = False, check: bool = True, capture: bool = False) -> int | str:
        cmd = ["ssh", *self.ssh_opts, *(["-t"] if tty else []), self.target, command]
        res = sh(cmd, check=False, capture_output=capture, text=capture or None)
        if res.returncode == 255:
            fail(f"ssh to {self.target} failed. Key login needed once: ssh-copy-id {self.target}")
        if check and res.returncode != 0:
            fail(f"remote command failed ({res.returncode}) on {self.name}")
        return res.stdout if capture else res.returncode

    def rsync(self, src: str, dest: str, delete: bool = True, exclude: tuple[str, ...] = (),
              filters: list[str] | None = None) -> None:
        """filters: rsync --include/--exclude rules, in order (applied after `exclude`)."""
        e = shlex.join(["ssh", *self.ssh_opts])
        sh(["rsync", "-az", *(["--delete"] if delete else []), *(f"--exclude={x}" for x in exclude),
            *(filters or []), "-e", e, src, f"{self.target}:{dest}"])

    def codename(self) -> str:
        """The board's Ubuntu release (boards.toml `codename`, else asked once)."""
        if "codename" not in self.cfg:
            self.cfg["codename"] = str(self.ssh(". /etc/os-release; echo $VERSION_CODENAME", capture=True)).strip()
        return self.cfg["codename"]


def cmd_board(p: Profile, a) -> None:
    if a.action == "list":
        inv = load_toml(REPO / "boards.toml")
        for name, cfg in inv.get("boards", {}).items():
            groups = " ".join(f"@{g}" for g in cfg.get("groups", []))
            print(f"{name:20} {cfg.get('host', '?'):18} {groups:16} {cfg.get('product', '')}")
        return
    board = Board(a.name, p)
    lock = p.sysroot / ".jxb/packages.lock"
    keys = ("nvidia-jetpack", "nvidia-l4t-core", "cuda-cudart-13-2", "libcudnn9-cuda-13", "libnvinfer10",
            "libnvvpi4", "libopencv", f"ros-{p.distro}-rclcpp", f"ros-{p.distro}-cv-bridge")
    out = board.ssh("cat /etc/nv_tegra_release; echo ---; dpkg-query -W -f='${Package}=${Version}\\n' "
                    + " ".join(keys) + " 2>/dev/null; echo ---; ls -d /opt/onnxruntime* 2>/dev/null; true",
                    capture=True)
    release, pkgs, extras = (out.split("---\n") + ["", ""])[:3]
    print(f"{board.name} ({board.target}): {release.strip()}")
    ours = dict(l.split("=", 1) for l in lock.read_text().splitlines()) if lock.exists() else {}
    mism = 0
    for line in pkgs.split():
        name, ver = line.split("=", 1)
        sv = ours.get(name, "-")
        flag = "ok " if sv == ver else ("   " if sv == "-" else "DIFF")
        mism += flag == "DIFF"
        print(f"  {flag} {name:28} board {ver:36} sysroot {sv}")
    print(f"  onnxruntime on board: {extras.strip() or 'missing'}")
    if mism:
        fail(f"{mism} package(s) differ between {board.name} and the sysroot")


def runtime_paths(p: Profile) -> list[str]:
    """Board-absolute dirs from the sysroot that deployments ship (profile [deploy] runtime), e.g. jxb's ORT build."""
    return [r for r in p.data.get("deploy", {}).get("runtime", []) if (p.sysroot / r.lstrip("/")).is_dir()]


def ship_ros(p: Profile, board: Board) -> None:
    """A ROS distro the board doesn't have (it keeps its stock JetPack, apt is not touched): the sysroot's
    /opt/ros/<distro> is relocatable and runs from <base>/runtime/opt/ros/<distro> on the same Ubuntu release.
    Headers and static libraries stay behind."""
    ros = f"/opt/ros/{p.distro}"
    if board.ssh(f"test -f {ros}/setup.bash", check=False) == 0:
        return
    codename = p.data["sysroot"].get("codename", "noble")
    if board.codename() != codename:
        fail(f"{p.name} is built for Ubuntu {codename}, {board.name} runs {board.codename()}: "
             "its binaries need that userland (--mode container)")
    dest = f"{board.base}/runtime{ros}"
    board.ssh(f"mkdir -p {shlex.quote(dest)}")
    info(f"{board.name} has no ROS {p.distro}: shipping the sysroot's {ros} -> {dest}")
    board.rsync(f"{p.sysroot / ros.lstrip('/')}/", dest, exclude=("/include/", "*.a"))
    ship_pydist(p, board)


def ship_pydist(p: Profile, board: Board) -> None:
    """System Python modules the shipped distro uses but the board's Python can't import (e.g. osrf_pycommon,
    which the board has only as its own distro's ros-<distro>-osrf-pycommon), to <base>/runtime/pydist."""
    src = p.sysroot / "usr/lib/python3/dist-packages"
    ours = {e.name.split(".")[0] for e in src.iterdir()
            if not e.name.endswith((".dist-info", ".egg-info", ".pth")) and not e.name.startswith("_")}
    have = set(str(board.ssh("python3 -c 'import pkgutil; print(\"\\n\".join(m.name for m in pkgutil.iter_modules()))'",
                             capture=True)).split())
    missing = sorted(ours - have)
    if not missing:
        return
    entries = [e.name for e in src.iterdir()
               if e.name.split(".")[0] in missing or e.name.split("-")[0].replace("-", "_") in missing]
    info(f"shipping {len(missing)} Python module(s) {board.name}'s Python lacks: {', '.join(missing[:8])}"
         + (" ..." if len(missing) > 8 else ""))
    dest = f"{board.base}/runtime/pydist"
    board.ssh(f"mkdir -p {shlex.quote(dest)}")
    board.rsync(f"{src}/", dest, delete=False,
                filters=[*(f"--include=/{e}/***" if (src / e).is_dir() else f"--include=/{e}" for e in entries),
                         "--exclude=*"])


# ---------------------------------------------------------------------------- runtime container on the board
# Profiles built for another Ubuntu release than the board's (Lyrical on 26.04) run in a container whose root is
# the profile's sysroot, minus what only builds need. arm64 image built on the host without emulation (docker
# import), GPU through the board's CDI spec. Orin's TensorRT loads only the sm86 builder resource.
RUNTIME_IMAGE_EXCLUDES = (
    "./usr/include", "./opt/ros/*/include", "./usr/local/cuda-*/targets/*/include", "./usr/local/cuda-*/nvvm",
    "./usr/local/cuda-*/bin", "*.a", "./usr/share/doc", "./usr/share/man", "./usr/share/info", "./usr/src",
    "./var/cache", "./var/lib/apt/lists",
    *(f"./usr/lib/aarch64-linux-gnu/libnvinfer_builder_resource_{a}.*"
      for a in ("ptx", "sm75", "sm80", "sm89", "sm90", "sm100", "sm110", "sm120")))


def uses_container(p: Profile, board: Board) -> bool:
    """--mode native|container (or jxb.toml mode); auto: [deploy] container = true/false, else whenever the
    profile's Ubuntu release is not the board's."""
    if p.mode != "auto":
        return p.mode == "container"
    explicit = p.data.get("deploy", {}).get("container")
    if explicit is not None:
        return bool(explicit)
    return p.data["sysroot"].get("codename", "noble") != board.codename()


def runtime_image(p: Profile) -> tuple[str, str]:
    """Tag of the profile's runtime image and the sysroot build it must come from."""
    return f"jxb-rt:{p.name}", json.loads((p.sysroot / ".jxb/info.json").read_text())["built"]


RUNTIME_LABEL = '{{index .Config.Labels "jxb.sysroot.built"}}'


def build_runtime_image(p: Profile) -> str:
    """The profile's runtime image on this host, (re)built when the sysroot build changed."""
    tag, built = runtime_image(p)
    local = subprocess.run(["docker", "image", "inspect", "-f", RUNTIME_LABEL, tag], capture_output=True, text=True)
    if local.stdout.strip() != built:
        if not (p.sysroot / "usr/bin/bash").exists():
            fail(f"{p.sysroot} has no shell for a container: rebuild it with the runtime-base package set "
                 "(jxb sysroot build)")
        info(f"building {tag}: arm64 runtime image from {p.sysroot}")
        tar = subprocess.Popen(["tar", "-C", str(p.sysroot), "-c", "--numeric-owner",
                                *(f"--exclude={x}" for x in RUNTIME_IMAGE_EXCLUDES), "."], stdout=subprocess.PIPE)
        sh(["docker", "import", "--platform", "linux/arm64", "--change", f"LABEL jxb.profile={p.name}",
            "--change", f"LABEL jxb.sysroot.built={built}", "--change", 'CMD ["bash"]', "-", tag],
           stdin=tar.stdout, stdout=subprocess.DEVNULL)
        if tar.wait() != 0:
            fail(f"tar of {p.sysroot} failed")
    return tag


def ensure_runtime_image(p: Profile, board: Board) -> None:
    """The board has the runtime image of the current sysroot build (built and loaded only when it changed)."""
    tag, built = runtime_image(p)
    on_board = str(board.ssh(f"docker image inspect -f '{RUNTIME_LABEL}' {tag} 2>/dev/null; true",
                             capture=True)).strip()
    if on_board == built:
        return
    build_runtime_image(p)
    info(f"loading {tag} on {board.name} (once per sysroot build; several GB)")
    old = str(board.ssh(f"docker image inspect -f '{{{{.Id}}}}' {tag} 2>/dev/null; true", capture=True)).strip()
    save = subprocess.Popen(["docker", "save", tag], stdout=subprocess.PIPE)
    zstd = subprocess.Popen(["zstd", "-T0", "-3", "-q"], stdin=save.stdout, stdout=subprocess.PIPE)
    sh(["ssh", *board.ssh_opts, board.target, "zstd -d -q | docker load"], stdin=zstd.stdout)
    if old:   # the previous build is untagged now
        board.ssh(f"docker rmi {old} >/dev/null 2>&1; true")


def prepare_board(p: Profile, board: Board) -> None:
    """What the profile's binaries need on the board besides the deployment: its ROS distro or its runtime image."""
    if uses_container(p, board):
        ensure_runtime_image(p, board)
    else:
        ship_ros(p, board)


def board_exec(p: Profile, board: Board, script: str, login: bool = True, tty: bool = False,
               name: str | None = None, x11: bool = False) -> str:
    """Remote command (for Board.ssh) that runs the shell script on the board: in bash, or for container profiles
    in the profile's runtime image with the GPU (CDI), host network/IPC (DDS) and <base> mounted at its path.
    The board's gdbserver and Nsight Systems are mounted in when present; with tty, closing the connection stops
    the container (docker forwards the hangup, --init passes it on). x11: the SSH session's forwarded display,
    with the X cookie file in $jxb_xa (X11_COOKIE)."""
    shell = shlex.join(["bash", "-lc" if login else "-c", script])
    if not uses_container(p, board):
        return shell
    base = board.base
    optional = " ".join(f'$([ -e {path} ] && echo "-v {path}:{path}:ro")'
                        for path in ("/usr/bin/gdbserver", CUDA_GDBSERVER, "/opt/nvidia/nsight-systems"))
    # GPU device nodes belong to video/render; by number, the image (the sysroot) has no such group names
    groups = " ".join(f'$(getent group {g} | cut -d: -f3 | sed "s/^/--group-add /")' for g in ("video", "render"))
    display = '-e DISPLAY -e XAUTHORITY="$jxb_xa" -v "$jxb_xa:$jxb_xa:ro" ' if x11 else ""
    return (f"docker run --rm --init -i{'t' if tty else ''} {f'--name {name} ' if name else ''}"
            "--network host --ipc host --device nvidia.com/gpu=all "
            f"--user $(id -u):$(id -g) {groups} -e HOME={base} -v {base}:{base} -w {base} {optional} {display}"
            f"{runtime_image(p)[0]} {shell}")


# Prints "HAVE <file name>" for the libraries below the given directories and "MISSING <soname>" for every library
# that ldd cannot resolve for their ELF files.
MISSING_LIBS_SH = r"""find "$@" \( -type f -o -type l \) -name '*.so*' -printf 'HAVE %f\n' 2>/dev/null
find "$@" -type f \( -name '*.so' -o -name '*.so.*' -o -perm -u+x \) -print0 2>/dev/null |
  xargs -0 -r -P4 -n 50 sh -c 'for f; do
    [ "$(head -c4 "$f" 2>/dev/null | tr -d "\177")" = ELF ] || continue
    ldd "$f" 2>/dev/null | awk "/not found/ {print \"MISSING \" \$1}"
  done' sh | sort -u"""


def ensure_board_libs(p: Profile, board: Board, env: str, dirs: list[str]) -> None:
    """Ship the sysroot's copy of every shared library the deployed files need but the board lacks (dependencies of
    a shipped ROS distro, of jxb's extras, ...) to <base>/runtime/syslibs, until ldd resolves everything."""
    stage = REPO / ".work/deploy" / p.name / board.name / "syslibs"
    search = ["/usr/lib/aarch64-linux-gnu", "/lib/aarch64-linux-gnu", f"/opt/ros/{p.distro}/lib",
              *runtime_paths(p)]
    for conf in sorted((p.sysroot / "etc/ld.so.conf.d").glob("*.conf")):
        search += [l.strip() for l in conf.read_text().splitlines() if l.startswith("/")]
    shipped: set[str] = set()
    check = env + f"set -- {' '.join(map(shlex.quote, dirs))}; " + MISSING_LIBS_SH
    for _ in range(5):   # shipped libraries may need further ones
        out = board.ssh(board_exec(p, board, check, login=False), capture=True)
        words = str(out).split()
        have = {name for kind, name in zip(words[::2], words[1::2]) if kind == "HAVE"}
        # Libraries of the deployment itself are found through its setup scripts at run time.
        missing = [name for kind, name in zip(words[::2], words[1::2])
                   if kind == "MISSING" and name not in have and name not in shipped]
        if not missing:
            return
        stage.mkdir(parents=True, exist_ok=True)
        unresolved = []
        for soname in missing:
            src = next((p.sysroot / d.lstrip("/") / soname for d in search
                        if (p.sysroot / d.lstrip("/") / soname).exists()), None)
            if src is None:
                unresolved.append(soname)
                continue
            shutil.copy2(src.resolve(), stage / soname)
            shipped.add(soname)
        if unresolved:
            fail(f"libraries missing on {board.name} and not in the sysroot: {', '.join(unresolved)}")
        info(f"shipping {len(missing)} librar{'y' if len(missing) == 1 else 'ies'} {board.name} lacks: "
             f"{', '.join(missing[:6])}{' ...' if len(missing) > 6 else ''}")
        board.ssh(f"mkdir -p {board.base}/runtime/syslibs")
        board.rsync(f"{stage}/", f"{board.base}/runtime/syslibs", delete=False)
    fail(f"could not resolve the libraries of {', '.join(dirs)} on {board.name}")


# Source-tree files deployed next to install/ by default (when present): launch files that include other launch
# files by path ($WORKSPACE_ROOT/src/...), their configs, and assets such as models. jxb.toml can replace the list.
WORKSPACE_FILES = ("launch/", "assets/", "src/*/launch/", "src/*/config/", "src/*/params/", "src/*/urdf/")


def incomplete_packages(install: Path) -> list[str]:
    """Packages whose colcon hooks (share/<pkg>/package.dsv) name files that aren't there: a failed or aborted build
    leaves such a directory, and sourcing the workspace's local_setup on the board would stop at it."""
    bad = []
    for dsv in sorted(install.glob("*/share/*/package.dsv")):
        pkg = dsv.parts[-4]
        # only the hooks bash uses (colcon lists every shell's, e.g. .ps1, which Linux installs never have)
        hooks = [line.split(";", 1)[1] for line in dsv.read_text().splitlines()
                 if line.startswith("source;") and line.endswith((".sh", ".bash", ".dsv"))]
        if any(not (install / pkg / h).exists() for h in hooks):
            bad.append(pkg)
    return bad


def deploy_workspace(p: Profile, board: Board, ws: Path, packages: list[str] | None = None,
                     files: bool = True) -> None:
    """install-<profile>/ (or only some of its packages) and the workspace's run-time files to <base>/<ws>/, plus
    what the board lacks for the profile (its ROS distro, the runtime image, jxb's runtime extras, libraries)."""
    src = ws / f"install-{p.name}"
    if not src.is_dir():
        fail(f"{src} not found; build first (jxb build)")
    prepare_board(p, board)
    root = f"{board.base}/{ws.name}"
    dest = f"{root}/install"
    board.ssh(f"mkdir -p {shlex.quote(dest)}")
    broken = incomplete_packages(src)
    if packages and set(packages) & set(broken):
        fail(f"failed to build for {p.name}: {', '.join(sorted(set(packages) & set(broken)))}")
    if broken:   # not deployed, and stale copies removed: the workspace's setup must stay sourceable
        info(f"not deploying incomplete packages (failed builds): {', '.join(broken)}")
        board.ssh(f"cd {shlex.quote(dest)} && rm -rf {' '.join(map(shlex.quote, broken))}")
    skip = [f"--exclude=/{pkg}/" for pkg in broken]
    if packages:
        unknown = [pkg for pkg in packages if not (src / pkg).is_dir()]
        if unknown:
            fail(f"not built for {p.name}: {', '.join(unknown)} (jxb build --packages-up-to ...)")
        info(f"deploy {', '.join(packages)} -> {board.name}:{dest}")
        # the packages' own trees plus colcon's top-level setup files; other deployed packages stay
        keep = [f"--include=/{pkg}/***" for pkg in packages]
        board.rsync(f"{src}/", dest, delete=False, filters=[*keep, "--include=/*.*", "--include=/_*", "--exclude=/*"])
    else:
        info(f"deploy {src} -> {board.name}:{dest}")
        board.rsync(f"{src}/", dest, filters=skip)
    patterns = p.workspace(ws).get("files", WORKSPACE_FILES) if files else []
    present = [pat for pat in patterns if list(ws.glob(pat.rstrip("/")))]
    if present:
        info(f"deploy workspace files {' '.join(present)} -> {board.name}:{root}")
        rules = [f"--include=/{pat}***" if pat.endswith("/") else f"--include=/{pat}" for pat in present]
        prune = ["--exclude=/build*/", "--exclude=/install*/", "--exclude=/log/", "--exclude=/.*/"]
        # Git LFS pointers (objects not pulled) must not replace the real files on the board
        pointers = [f.relative_to(ws) for pat in present for f in ws.glob(pat.rstrip("/") + "/**/*")
                    if f.is_file() and f.stat().st_size < 1024
                    and f.read_bytes()[:40].startswith(b"version https://git-lfs.github.com/spec/")]
        for ptr in pointers:
            info(f"skipping {ptr}: Git LFS pointer, the file itself is not here (git lfs pull)")
        prune += [f"--exclude=/{ptr}" for ptr in pointers]
        board.rsync(f"{ws}/", root, delete=False,
                    filters=[*prune, "--include=*/", *rules, "--exclude=*", "--prune-empty-dirs"])
    # Runtime extras go next to the deployment, never into the board's own /opt (shared boards stay untouched).
    for r in runtime_paths(p):
        rdest = f"{board.base}/runtime{r}"
        board.ssh(f"mkdir -p {shlex.quote(rdest)}")
        info(f"deploy runtime {r} -> {board.name}:{rdest}")
        board.rsync(f"{p.sysroot / r.lstrip('/')}/", rdest)
    ensure_board_libs(p, board, board_env_script(p, board, ws), [dest, f"{board.base}/runtime"])


def cmd_deploy(p: Profile, a) -> None:
    deploy_workspace(p, Board(a.name, p), Path(a.ws or Path.cwd()).resolve(), a.packages, files=not a.no_files)


def board_ros_setup(p: Profile, board: Board) -> str:
    """Shell prefix that sources the board's ROS underlay, or the copy from ship_ros when the board has no such
    distro; exports the setup script's path as JXB_ROS_SETUP."""
    ros = f"/opt/ros/{p.distro}"
    # Python modules shipped with the distro (ship_pydist), after everything else on the path; native only
    pydist = "" if uses_container(p, board) else (
        f"[ -d {board.base}/runtime/pydist ] && export PYTHONPATH=${{PYTHONPATH:+$PYTHONPATH:}}"
        f"{board.base}/runtime/pydist; ")
    return (f"set +u; {pydist}export JXB_ROS_SETUP={ros}/setup.bash; [ -f $JXB_ROS_SETUP ] || "
            f"JXB_ROS_SETUP={board.base}/runtime{ros}/setup.bash; source $JXB_ROS_SETUP && ")


def board_runtime_libs(p: Profile, board: Board) -> str:
    """Shell prefix that puts jxb's runtime extras and shipped system libraries on LD_LIBRARY_PATH."""
    libs = [f"{board.base}/runtime{r}/lib" for r in runtime_paths(p)] + [f"{board.base}/runtime/syslibs"]
    return f"export LD_LIBRARY_PATH={':'.join(libs)}:$LD_LIBRARY_PATH && "


def board_launch_args(board: "Board", ws: Path, args: list[str]) -> list[str]:
    """Launch target and arguments for the board: an empty package (unset VS Code setting) dropped, launch files of
    the workspace (e.g. launch/launch.py) mapped to their deployed copies."""
    out = []
    for arg in args:
        if not arg:
            continue
        if not arg.startswith("-") and ":=" not in arg and (ws / arg).is_file():
            arg = f"{board.base}/{ws.name}/{arg}"
        out.append(arg)
    return out


def board_ws_env(p: Profile, board: "Board", ws: Path) -> str:
    """Shell prefix with the workspace's environment on the board: WORKSPACE_ROOT (the deployed workspace, where
    launch files find src/ and assets/) and jxb.toml's env / container_env ({ws} = that directory)."""
    root = f"{board.base}/{ws.name}"
    cfg = p.workspace(ws)
    # boards.toml's ros_domain_id keeps the ROS 2 traffic of boards on one network apart; a workspace that must
    # share a domain with the host (hardware in the loop) sets ROS_DOMAIN_ID in its env, which wins
    domain = {"ROS_DOMAIN_ID": board.cfg["ros_domain_id"]} if "ros_domain_id" in board.cfg else {}
    env = {"WORKSPACE_ROOT": root, **domain, **cfg.get("env", {}),
           **(cfg.get("container_env", {}) if uses_container(p, board) else {})}
    return "".join(f"export {k}={shlex.quote(str(v).replace('{ws}', root))} && " for k, v in env.items())


def board_env_script(p: Profile, board: "Board", ws: Path) -> str:
    """Shell prefix that gives a remote command the ROS underlay, the deployed install and jxb's runtime extras."""
    # local_setup: the underlay is sourced explicitly (it may not be the /opt/ros path recorded at build time)
    setup = f"{board.base}/{ws.name}/install/local_setup.bash"
    return (board_ros_setup(p, board) + f"if [ -f {setup} ]; then source {setup}; fi && "
            + board_runtime_libs(p, board) + board_ws_env(p, board, ws))


def cmd_run(p: Profile, a) -> None:
    board = Board(a.name, p)
    ws = Path(a.ws or Path.cwd()).resolve()
    script = board_env_script(p, board, ws) + shlex.join(a.cmd)
    tty = sys.stdout.isatty()
    sys.exit(board.ssh(board_exec(p, board, script, tty=tty), tty=tty, check=False))


def gdb_init(p: Profile, install: Path) -> list[str]:
    """gdb commands for a cross session: board libraries from the sysroot, workspace and runtime libraries by name."""
    libdirs = sorted({str(d) for d in install.glob("*/lib")} | {str(d) for d in install.glob("*/lib/*") if d.is_dir()})
    libdirs += [str(p.sysroot / r.lstrip("/") / "lib") for r in runtime_paths(p)]
    return ["set pagination off", "set debuginfod enabled off", "set breakpoint pending on",
            f"set sysroot {p.sysroot}", f"set solib-search-path {':'.join(libdirs)}"]


CUDA_GDBSERVER = "/usr/local/cuda/bin/cuda-gdbserver"   # JetPack's CUDA toolkit
CUDA_GDB = "/usr/local/cuda/bin/cuda-gdb"               # the image's x86 build, debugs aarch64 targets


def check_gpu_debugging(board: Board) -> None:
    """Jetson lets only members of the group owning the GPU debugger device (debug) debug CUDA kernels; others get
    CPU-only sessions (cuda-gdbserver: "Device node does not allow debugging for the current user")."""
    node = "/dev/nvhost-dbg-gpu"
    group = str(board.ssh(f"[ -e {node} ] && ! {{ [ -r {node} ] && [ -w {node} ]; }} && stat -c %G {node}",
                          capture=True, check=False) or "").strip()
    if group:
        info(f"GPU debugging is off for {board.user} on {board.name} ({node} belongs to group {group}): CPU code "
             f"can be debugged, CUDA kernels can't. Once, as root on the board: usermod -aG {group} {board.user}")


def cmd_debug(p: Profile, a) -> None:
    """gdbserver on the board, gdb-multiarch in the container with the sysroot and the local (unstripped) binaries.

    gdbserver listens on the board's loopback only and is reached through the SSH session that starts it
    (local port forward), so nothing is exposed on the lab network and no firewall rule is needed.
    With --launch, the node is started by its launch file and only the executable --exe runs under gdbserver.
    With --cuda, NVIDIA's cuda-gdbserver and cuda-gdb take their place (host and device code)."""
    board = Board(a.name, p)
    ws = Path(a.ws or Path.cwd()).resolve()
    install = ws / f"install-{p.name}"
    local = install / a.pkg / "lib" / a.pkg / a.exe
    if not local.is_file():
        fail(f"{local} not found (build and deploy first; use RelWithDebInfo/Debug for line info)")
    remote = f"{board.base}/{ws.name}/install/{a.pkg}/lib/{a.pkg}/{a.exe}"
    port = int(a.port or board.cfg.get("gdb_port", 3000))
    gdbserver = [board.cfg.get("cuda_gdbserver", CUDA_GDBSERVER) if a.cuda else "gdbserver", "--once",
                 f"127.0.0.1:{port}"]
    if a.cuda:
        check_gpu_debugging(board)
    if a.launch:
        server = shlex.join(["exec", "ros2", "launch", *board_launch_args(board, ws, [*a.launch, *a.cmd]),
                             "--launch-prefix", shlex.join(gdbserver),
                             "--launch-prefix-filter", f"^{re.escape(a.exe)}$"])
    else:
        server = shlex.join(["exec", *gdbserver, remote, *a.cmd])
    # -tt: with a terminal on the board, closing the connection hangs up everything it started (gdbserver, and with
    # --launch the other nodes of the launch file), so nothing keeps running after the debug session.
    ssh = ["ssh", *board.ssh_opts, "-tt", "-o", "ExitOnForwardFailure=yes", "-L", f"{port}:127.0.0.1:{port}",
           board.target, board_exec(p, board, board_env_script(p, board, ws) + server, tty=True)]
    if a.server_only:   # VS Code's preLaunchTask: gdbserver and the tunnel in the foreground, cppdbg is the client
        info(f"gdbserver for {a.exe} on {board.name}, forwarded to 127.0.0.1:{port}")
        sys.exit(sh(ssh, check=False).returncode)
    # stdin stays with gdb: ssh must not read the terminal
    proc = subprocess.Popen(ssh, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in proc.stdout:   # wait until gdbserver listens
        print(f"[board] {line.rstrip()}", flush=True)
        if "Listening on port" in line:
            break
    else:
        fail("gdbserver did not start on the board")
    # Keep forwarding the program's output: an undrained pipe would block it once the buffer is full.
    threading.Thread(target=lambda: [print(f"[board] {l.rstrip()}", flush=True) for l in proc.stdout],
                     daemon=True).start()
    gdb_args = ["-q", *(["--batch"] if a.batch else [])]
    # cuda-gdb over cuda-gdbserver resumes in the background: batch commands after `continue` would run before the
    # stop ("Cannot execute this command while the target is running")
    sync = ["maint set target-async off"] if a.cuda and a.batch else []
    for cmd in [*sync, f"file {local}", f"target remote 127.0.0.1:{port}", *(a.gdb_cmd or [])]:
        gdb_args += ["-ex", cmd]
    rc = subprocess.run(gdb_command(p, ws, gdb_args, cuda=a.cuda)).returncode
    proc.terminate()
    sys.exit(rc)


def host_gdb() -> str | None:
    """A host gdb that can debug aarch64 (gdb-multiarch, or a gdb built with --enable-targets=all as on Arch)."""
    for name in ("gdb-multiarch", "gdb"):
        path = shutil.which(name)
        if path and '"aarch64"' in subprocess.run([path, "-nx", "--batch", "-ex", "set architecture aarch64"],
                                                  capture_output=True, text=True).stdout:
            return path
    return None


def gdb_command(p: Profile, ws: Path, args: list[str], cuda: bool = False) -> list[str]:
    """Cross gdb set up for the profile's sysroot and the workspace's install tree: the host's gdb if it supports
    aarch64, else gdb-multiarch in the container (same paths there; stdin stays attached for MI clients). With
    cuda, the container's cuda-gdb."""
    init = [x for cmd in gdb_init(p, ws / f"install-{p.name}") for x in ("-iex", cmd)]
    gdb = None if cuda else host_gdb()
    if gdb:
        return [gdb, *init, *args]
    ensure_up(p)
    if cuda and subprocess.run(["docker", "exec", p.container, "test", "-x", CUDA_GDB]).returncode != 0:
        fail(f"{p.container} has no cuda-gdb: rebuild its image (jxb --profile {p.name} image build), then "
             "jxb up --recreate")
    tty = ["-t"] if sys.stdin.isatty() and sys.stdout.isatty() else []
    return ["docker", "exec", "-i", *tty, "-w", str(ws), p.container, CUDA_GDB if cuda else "gdb-multiarch", *init,
            *args]


def cmd_gdb(p: Profile, a) -> None:
    """Cross gdb for the profile (see gdb_command); VS Code's cppdbg runs it through toolchain/bin/jxb-gdb."""
    cmd = gdb_command(p, Path(a.ws or Path.cwd()).resolve(), a.cmd, cuda=a.cuda)
    os.execvp(cmd[0], cmd)


# The X cookie of the session's forwarded display as a host-independent entry (family ffff) in a file of its own:
# a container has its own host name, which the session's entry (<board>/unix:10) doesn't match.
X11_COOKIE = 'jxb_xa=$(mktemp); xauth nlist "$DISPLAY" | sed -e "s/^..../ffff/" | xauth -f "$jxb_xa" nmerge -; '


def cmd_gui(p: Profile, a) -> None:
    """A program on the board as a window on this desktop (single windows, no desktop session on the board): SSH
    X11 forwarding with the deployment's environment, natively or in the runtime container. Trusted forwarding
    (-Y), since hosts often lack xauth."""
    if not a.cmd:
        fail("usage: jxb gui NAME -- PROGRAM [ARGS ...]")
    if not os.environ.get("DISPLAY"):
        fail("no X display on this host (DISPLAY is unset; on Wayland, XWayland provides one)")
    board = Board(a.name, p)
    script = board_env_script(p, board, Path(a.ws or Path.cwd()).resolve()) + shlex.join(a.cmd)
    if uses_container(p, board):
        remote = X11_COOKIE + board_exec(p, board, script, x11=True) + '; rc=$?; rm -f "$jxb_xa"; exit $rc'
    else:
        remote = board_exec(p, board, script)
    info(f"{a.cmd[0]} on {board.name}, displayed here")
    sys.exit(sh(["ssh", *board.ssh_opts, "-Y", board.target, remote], check=False).returncode)


def cmd_ssh(p: Profile, a) -> None:
    """Interactive shell on the board with the ROS underlay, the deployed workspace and jxb's runtime sourced."""
    board = Board(a.name, p)
    ws = Path(a.ws or Path.cwd()).resolve()
    script = board_env_script(p, board, ws) + "exec bash -i"
    rc = board.ssh(board_exec(p, board, script, login=False, tty=True), tty=True, check=False)
    sys.exit(rc)


