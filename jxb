def board_names(spec: str) -> list[str]:
    """The boards a NAME argument means: a board, a comma list, @GROUP (boards whose `groups` include it) or all."""
    inv = load_toml(REPO / "boards.toml").get("boards", {})
    names: list[str] = []
    for part in filter(None, spec.split(",")):
        if part == "all":
            names += list(inv)
        elif part.startswith("@"):
            group = [n for n, c in inv.items() if part[1:] in c.get("groups", [])]
            if not group:
                fail(f"no board in group {part[1:]} (boards.toml: groups = [...])")
            names += group
        else:
            names.append(part)
    return list(dict.fromkeys(names))


def fan_out(argv: list[str], spec: str, boards: list[str]) -> None:
    """Runs this jxb command once per board, all at once: every output line carries its board's name, and a table
    of exit codes and wall times follows. Ctrl-C reaches every run (same process group); jxb waits for them to
    stop cleanly."""
    i = argv.index(spec)
    runs, saved = {}, []

    def relay(b: str, proc: subprocess.Popen) -> None:
        for line in proc.stdout:
            print(f"[{b}] {line.rstrip()}", flush=True)
            if "trace saved: " in line:   # the recordings, for one timeline of all boards
                saved.append(Path(line.split("trace saved: ", 1)[1].strip()))

    for b in boards:
        proc = subprocess.Popen([sys.executable, str(REPO / "jxb"), *argv[:i], b, *argv[i + 1:]],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                errors="replace")
        out = threading.Thread(target=relay, args=(b, proc), daemon=True)
        out.start()
        runs[b] = (proc, out, time.time())
    width = max(map(len, boards))
    rows = []
    for b, (proc, out, t0) in runs.items():
        while True:
            try:
                rc = proc.wait()
                break
            except KeyboardInterrupt:   # the runs got SIGINT as well and stop their boards' work
                continue
        out.join()
        rows.append(f"  {b:{width}}  rc={rc:<4} {time.time() - t0:7.1f} s")
    print(f"\n{len(boards)} boards:\n" + "\n".join(rows))
    if len(saved) > 1:
        jxb_trace.timeline(sorted(saved))
    sys.exit(1 if any(proc.returncode for proc, _, _ in runs.values()) else 0)


# jxb's commands whose board argument may name several boards (fan_out); ssh, gui and debug are interactive
FAN_OUT = {"deploy", "run", "launch", "board", "test", "trace"}


def main() -> None:
    global DRY_RUN
    # Started as a background job of a non-interactive shell (a script, a GUI), jxb inherits SIGINT ignored and
    # could not be stopped with it (docs/findings.md F69): restore Python's KeyboardInterrupt handler.
    signal.signal(signal.SIGINT, signal.default_int_handler)
    ap = argparse.ArgumentParser(prog="jxb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action=_VersionAction, nargs=0, help="jxb's version and commit")
    ap.add_argument("--profile")
    ap.add_argument("--mode", choices=["auto", "native", "container"],
                    help="run on the board natively or in the profile's runtime container; auto (default, jxb.toml "
                         "mode): container only when the profile's Ubuntu release differs from the board's")
    ap.add_argument("--dry-run", action="store_true")
    sub = ap.add_subparsers(dest="command", required=True)
    s = sub.add_parser("image"); s.add_argument("action", choices=["build", "runtime"]); s.set_defaults(fn=cmd_image)
    s = sub.add_parser("sysroot"); s.add_argument("action", choices=["build", "info", "rosdeps"])
    s.add_argument("--add", nargs="*", default=[]); s.add_argument("--no-update", action="store_true")
    s.add_argument("-w", "--workspace")
    s.set_defaults(fn=cmd_sysroot)
    s = sub.add_parser("up"); s.add_argument("-w", "--workspace", action="append")
    s.add_argument("--recreate", action="store_true"); s.set_defaults(fn=cmd_up)
    sub.add_parser("down").set_defaults(fn=cmd_down)
    sub.add_parser("shell").set_defaults(fn=cmd_shell)
    s = sub.add_parser("exec"); s.add_argument("cmd", nargs=argparse.REMAINDER); s.set_defaults(fn=cmd_exec)
    s = sub.add_parser("build"); s.add_argument("args", nargs=argparse.REMAINDER); s.set_defaults(fn=cmd_build)
    s = sub.add_parser("test"); s.add_argument("--board"); s.set_defaults(fn=cmd_test)
    s = sub.add_parser("board"); s.add_argument("action", choices=["list", "check"]); s.add_argument("name", nargs="?")
    s.set_defaults(fn=cmd_board)
    s = sub.add_parser("deploy"); s.add_argument("name"); s.add_argument("--ws")
    s.add_argument("--packages", nargs="+", metavar="PKG", help="deploy only these packages of install-<profile>/")
    s.add_argument("--no-files", action="store_true", help="skip the workspace's run-time files (launch/, assets/...)")
    s.set_defaults(fn=cmd_deploy)
    s = sub.add_parser("run"); s.add_argument("name"); s.add_argument("--ws")
    s.set_defaults(fn=cmd_run, cmd=[])   # the command after "--" is split off before parsing
    s = sub.add_parser("debug"); s.add_argument("name"); s.add_argument("--ws"); s.add_argument("--port", type=int)
    s.add_argument("--pkg", required=True); s.add_argument("--exe", required=True)
    s.add_argument("--launch", nargs=2, metavar=("PKG", "FILE"), help="start EXE through this launch file")
    s.add_argument("--gdb-cmd", action="append", help="gdb command to run after connecting (repeatable)")
    s.add_argument("--batch", action="store_true", help="non-interactive gdb (with --gdb-cmd)")
    s.add_argument("--server-only", action="store_true", help="only start gdbserver (for VS Code's cppdbg)")
    s.add_argument("--cuda", action="store_true", help="cuda-gdbserver + cuda-gdb: CUDA kernels too")
    s.set_defaults(fn=cmd_debug, cmd=[])
    s = sub.add_parser("gdb"); s.add_argument("--ws"); s.add_argument("--cuda", action="store_true", help="cuda-gdb")
    s.set_defaults(fn=cmd_gdb, cmd=[])
    s = sub.add_parser("ssh"); s.add_argument("name"); s.add_argument("--ws"); s.set_defaults(fn=cmd_ssh)
    s = sub.add_parser("gui"); s.add_argument("name"); s.add_argument("--ws")
    s.set_defaults(fn=cmd_gui, cmd=[])   # the program after "--" is split off before parsing
    jxb_trace.register(sub, sys.modules[__name__])
    jxb_vscode.register(sub, sys.modules[__name__])
    jxb_launch.register(sub, sys.modules[__name__])
    # build/exec/run/debug/gdb pass everything after the subcommand (and the board name) through untouched;
    # argparse would otherwise try to interpret colcon, remote or gdb options. jxb's own options come first.
    own = {"run": {"--ws": 2}, "gui": {"--ws": 2}, "gdb": {"--ws": 2, "--cuda": 1},
           "debug": {"--ws": 2, "--port": 2, "--pkg": 2, "--exe": 2, "--gdb-cmd": 2, "--launch": 3, "--batch": 1,
                     "--server-only": 1, "--cuda": 1}}
    argv, passthrough = sys.argv[1:], None
    for i, tok in enumerate(argv):
        if tok in ("trace", "launch"):   # ... NAME [options] -- CMD: all of jxb's options come before "--"
            if "--" in argv[i:]:
                j = argv.index("--", i)
                argv, passthrough = argv[:j], argv[j:]
            break
        if tok in ("build", "exec", "run", "debug", "gdb", "gui"):
            keep = i + (2 if tok in ("run", "debug", "gui") else 1)
            argv, passthrough = argv[:keep], argv[keep:]
            while passthrough[:1] and passthrough[0] in own.get(tok, {}):
                n = own[tok][passthrough[0]]
                argv, passthrough = argv + passthrough[:n], passthrough[n:]
            break
        if not tok.startswith("-") and argv[i - 1:i] not in (["--profile"], ["--mode"]):   # global option values
            break
    a = ap.parse_args(argv)
    if passthrough is not None:
        if passthrough[:1] == ["--"]:
            passthrough = passthrough[1:]
        setattr(a, "args" if a.command == "build" else "cmd", passthrough)
    DRY_RUN = a.dry_run
    if a.command == "board" and a.action != "list" and not a.name:
        fail("usage: jxb board check NAME")
    spec = getattr(a, "board" if a.command == "test" else "name", None) if a.command in FAN_OUT else None
    if spec and getattr(a, "trace_cmd", None) != "gui" and ("," in spec or spec == "all" or spec.startswith("@")):
        fan_out(sys.argv[1:], spec, board_names(spec))
    if shutil.which("docker") is None and a.command not in ("board", "deploy", "run", "ssh", "gui", "gdb", "debug",
                                                            "trace", "vscode", "launch"):
        fail("docker not found")
    prof = Profile(a.profile)
    prof.mode = a.mode or prof.mode
    a.fn(prof, a)


if __name__ == "__main__":
    main()
