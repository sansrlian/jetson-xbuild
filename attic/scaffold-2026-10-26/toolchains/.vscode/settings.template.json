{
    "#": "DO NOT EDIT THIS FILE — edit settings.json / use `board select`",
    "HOST_GDB_PATH": "/usr/bin/gdb-multiarch",
    "TARGET_LOCAL_SYSROOT": "${env:ARM64_SYSROOT}",
    "ACTIVE_BOARD": "orin-agx-01",
    "BOARDS_FILE": "/home/ubuntu/boards.yaml",
    "TARGET_IP": "192.168.100.11",
    "TARGET_GDB_PORT": "2345",
    "TARGET_USER": "ubuntu",
    "TARGET_PASSWORD": "",
    "TARGET_ROS2_WS": "/home/ubuntu/ros2_ws",

    "NODE_PACKAGE_NAME": "node_package_name",
    "NODE_EXECUTABLE_NAME": "node_executable_name",
    "LAUNCH_PACKAGE_NAME": "launch_package_name",
    "LAUNCH_FILE_NAME": "your_launch_file_launch_py",

    "cmake.cmakePath": "/usr/bin/cmake",
    "cmake.buildBeforeRun": false,
    "terminal.integrated.profiles.linux": {
        "SSH active board": {
            "path": "bash",
            "args": ["-c", "board ssh"],
            "icon": "remote"
        }
    },

    "VsCodeTaskButtons.tasks": [
        { "label": "$(rocket) Deploy", "task": "ROS2: Deploy to Target", "color": "warning" },
        { "label": "$(rocket) Deploy ALL", "task": "ROS2: Deploy All Boards", "color": "warning" },
        { "label": "$(notebook-delete-cell) Clean All", "task": "ROS2: Clean All", "color": "error" },
        { "label": "$(run-above) Run LaunchFile", "task": "ROS2: Launch Package LaunchFile" },
        { "label": "$(run) Run Executable", "task": "ROS2: Run Package Executable" },
        { "label": "$(graph) Nsight Systems", "task": "NVIDIA: Nsight Systems (active)" },
        { "label": "$(dashboard) tegrastats", "task": "NVIDIA: tegrastats (active)" },
        { "label": "$(terminal) SSH", "task": "ROS2: SSH to Target" }
    ]
}
