#!/usr/bin/env python3
"""Resolve a workspace's rosdep keys to the board's apt packages and write them as a sysroot package set.

    jxb-rosdeps <workspace> <set-file>

Uses the board's OS and ROS distro (ubuntu:$JXB_UBUNTU_CODENAME, $ROS_DISTRO). If $JXB_ROSDEP_FALLBACK_CODENAME is
set (a distro built for another Ubuntu, e.g. Lyrical for noble from NVIDIA's Isaac ROS Buildfarm), keys that don't
resolve are retried there and accepted only if they map to ros-<distro>-* packages. Keys that resolve to pip are
reported, not written; keys that don't resolve at all are an error (exit 1), since the sysroot would silently lack
them. The set is picked up by `jxb sysroot build` via jxb.toml [sysroot] extra_sets.
"""
import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    ws, out = Path(sys.argv[1]), Path(sys.argv[2])
    distro = os.environ.get("ROS_DISTRO", "jazzy")
    os_arg = f"--os=ubuntu:{os.environ.get('JXB_UBUNTU_CODENAME', 'noble')}"
    fallback = os.environ.get("JXB_ROSDEP_FALLBACK_CODENAME")
    subprocess.run(["rosdep", "update", "--rosdistro", distro], check=True, stdout=subprocess.DEVNULL)
    keys = subprocess.run(["rosdep", "keys", "--from-paths", str(ws / "src"), "--ignore-src", "-i",
                           "--rosdistro", distro], check=True, capture_output=True, text=True).stdout.split()
    apt, other, missing = set(), {}, []
    for key in sorted(set(keys)):
        res = subprocess.run(["rosdep", "resolve", key, os_arg, "--rosdistro", distro],
                             capture_output=True, text=True)
        if res.returncode != 0 and fallback:
            alt = subprocess.run(["rosdep", "resolve", key, f"--os=ubuntu:{fallback}", "--rosdistro", distro],
                                 capture_output=True, text=True)
            names = [w for l in alt.stdout.splitlines() if not l.startswith("#") for w in l.split()]
            if alt.returncode == 0 and names and all(n.startswith(f"ros-{distro}-") for n in names):
                res = alt
        if res.returncode != 0:
            missing.append(key)
            continue
        installer = None
        for line in res.stdout.splitlines():
            if line.startswith("#"):
                installer = line[1:].strip()
            elif line.strip():
                (apt.update if installer == "apt" else other.setdefault(installer, set()).update)(line.split())
    out.write_text(f"# rosdep keys of {ws} resolved for {distro} ({os_arg[5:]}); generated by jxb-rosdeps\n"
                   + "".join(f"{p}\n" for p in sorted(apt)))
    print(f"{len(keys)} keys -> {len(apt)} apt packages in {out}")
    for inst, pkgs in other.items():
        print(f"not in sysroot ({inst}): {' '.join(sorted(pkgs))}")
    if missing:
        print(f"ERROR: unresolved keys for {distro}/{os_arg[5:]}: {' '.join(missing)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
